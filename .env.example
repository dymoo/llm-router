# Copy via `node scripts/setup.mjs` (Compose) or `node scripts/setup.mjs --native`.
# Setup writes a mode-0600 env file with a generated API_KEY_PEPPER and
# refuses to overwrite. Do not commit `.env`, `.env.native`, the live
# catalogue, or the SQLite directory.
#
# No UI login. Anyone who can reach the bound address is an admin.
# Inference still requires API keys. Default bind is loopback.

# Must match the exact origin the browser uses (scheme + host + port).
APP_ORIGIN=http://127.0.0.1:3000

# Generated by setup. Leave empty here.
API_KEY_PEPPER=

# Optional admin-only HTTP Basic auth (username:password). Absent = no gate.
# Malformed values must fail gateway startup. Protects UI + admin API only,
# never inference. Use HTTPS if the hop is not a trusted private network.
# ADMIN_BASIC_AUTH=admin:change-me

# Compose control-plane paths (volume-backed). Native host paths are written
# by `node scripts/setup.mjs --native` into `.env.native`.
SQLITE_PATH=/var/lib/llm-router/control.sqlite

# Runtime catalogue. The example file is refused for inference until every
# REPLACE_ field is replaced with values discovered from live endpoints.
MODEL_CATALOG=/etc/llm-router/catalog.json

# Local classifier. Compose DNS name `laya` is reachable on the private
# network; do not publish that port.
LAYA_URL=http://laya:8090

# laya | jev
# Default is local Laya (CPU). `jev` requires TYPESAFE_API_KEY and sends
# task briefs to cloud Jev. There is no automatic Jev fallback on Laya
# failure.
CLASSIFIER_MODE=laya
# Qualification evidence (JSON array; shape: classifier-qualification.example.json).
# Compose pins CLASSIFIER_QUALIFICATION to the mounted container path from the
# gateway environment (any .env value for it is overridden there);
# CLASSIFIER_QUALIFICATION_FILE below selects the host record bound read-only
# at that path. The shipped example is deliberately invalid evidence (verdict
# "fail", REPLACE_ placeholders), so the default stays fail-closed unready —
# select a real operator record explicitly; records are never generated.
# Native: set a local path instead; absent = no qualifying record, so
# assessment use fails closed as unready.
# CLASSIFIER_QUALIFICATION=./classifier-qualification.json
CLASSIFIER_QUALIFICATION_FILE=./classifier-qualification.example.json
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Optional endpoint override for an explicitly configured compatible service.
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Named by catalogue entries. Empty in the example. Fill only in `.env`.
# OPENROUTER_API_KEY=
# ZAI_API_KEY=

# Laya process (consumed by the laya service). CPU is the only default.
# Root checkpoint max_len=512 / head=192; do not assume 1k state.
LAYA_HOST=0.0.0.0
LAYA_PORT=8090
LAYA_BACKEND=cpu
LAYA_MODEL_ID=convaiinnovations/laya
LAYA_MODEL_REVISION=1c5edc17a7acd8701df6fc341c0d179f1c62c982
LAYA_MODEL_SUBFOLDER=
LAYA_CACHE_DIR=/var/cache/laya
LAYA_ONNX_PATH=/var/cache/laya/onnx/laya.onnx
LAYA_EP_CONTEXT_DIR=/var/cache/laya/ep-context
LAYA_NPU_ASSIGNMENT_THRESHOLD=0.95
LAYA_MAX_BODY_BYTES=524288
LAYA_MAX_CONCURRENCY=1
LAYA_MEMORY_BUDGET_MB=4096

# Published gateway bind. Default loopback. For private LAN, set both
# GATEWAY_BIND to that interface IP and APP_ORIGIN to the matching origin.
# Never 0.0.0.0 on a public network.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3000

# Runtime choice: setup.mjs --runtime llamacpp-native|llamacpp|halogen|cloud.
# Only ONE GPU profile on a full-size-model host. Add npu/webui comma-separated.
COMPOSE_PROFILES=
MODEL_CATALOG_FILE=./catalog.json
#
# Container llama.cpp: pinned upstream Vulkan compatibility build, not the
# optimized native pwilkin build. Compatible fork images may override the image
# and executable. Model paths are relative to LLAMACPP_MODELS_DIR.
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:ff539c7fa68cb8487f822fa428f9d2e50f73eac23baba0a1018206ae050aaae2
LLAMACPP_SERVER_BIN=/app/llama-server
LLAMACPP_MODELS_DIR=./data/llamacpp-models
LLAMACPP_MODEL_FILE=
LLAMACPP_MODEL_ID=local-llamacpp
LLAMACPP_CONTEXT=65536
LLAMACPP_SLOTS=1
LLAMACPP_MAX_OUTPUT_TOKENS=8192
LLAMACPP_LOAD_MODE=mmap
LLAMACPP_LAZY_MODE=on
LLAMACPP_SPEC_TYPE=none
LLAMACPP_DRAFT_MODEL=
# Optional endpoint override; native gateway examples use 127.0.0.1.
# LLAMACPP_ENDPOINT=http://host.docker.internal:8080/v1
#
# Halogen official HGN + required QUALITY overlay. First profile start can
# download ~118 GiB. Set HALOGEN_DOWNLOAD= (empty) to prohibit downloads.
HALOGEN_DOWNLOAD=peonist-ai/halogen-qwen3.8-flash-next
HALOGEN_MODELS_DIR=./data/halogen-models
HALOGEN_CACHE_DIR_HOST=./data/halogen-cache
HALOGEN_MODEL_ID=halogen-qwen3.8-flash-next
HALOGEN_CTX=262144
HALOGEN_KV_SLOTS=4
HALOGEN_KV_POOL_POSITIONS=
HALOGEN_MAX_TOK=32768
HALOGEN_MAX_TOKENS_CAP=65536
HALOGEN_ROPE_YARN=
# Model-card thinking-mode defaults; a client-supplied temperature still wins.
HALOGEN_TEMPERATURE=1.0
HALOGEN_TOP_P=0.95
HALOGEN_TOP_K=20
# HALOGEN_ENDPOINT=http://halogen:8731/v1
#
# Numeric host device groups. Setup detects these on Linux when devices exist.
# Otherwise these are example values: check your AMD host before starting.
GPU_VIDEO_GID=44
GPU_RENDER_GID=109

# Optional NPU profile: COMPOSE_PROFILES=npu (or npu,webui).
# Enable its catalogue only after validating the NPU runtime. Copy the example
# to a private file and set AUXILIARY_CATALOG_FILE if accounting rates change.
# AUXILIARY_CATALOG=/etc/llm-router/auxiliary.json
# AUXILIARY_CATALOG_FILE=catalog.auxiliary.json
#
# Optional Open WebUI. Use a dedicated GATEWAY API key created in the console;
# never put the OpenRouter key here. Setup generates the stable WebUI secret.
WEBUI_GATEWAY_KEY=
WEBUI_SECRET_KEY=
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3001
WEBUI_ORIGIN=http://127.0.0.1:3001
