# Copy via `node scripts/setup.mjs` (Compose) or `node scripts/setup.mjs --native`.
# Setup writes a mode-0600 env file with a generated API_KEY_PEPPER and
# refuses to overwrite. Do not commit `.env`, `.env.native`, the live
# catalogue, or the SQLite directory.
#
# No UI login. Anyone who can reach the bound address is an admin.
# Inference still requires API keys. Default bind is loopback.

# Must match the exact origin the browser uses (scheme + host + port).
APP_ORIGIN=http://127.0.0.1:3000

# Generated by setup. Leave empty here.
API_KEY_PEPPER=

# Compose control-plane paths (volume-backed). Native host paths are written
# by `node scripts/setup.mjs --native` into `.env.native`.
SQLITE_PATH=/var/lib/llm-router/control.sqlite

# Runtime catalogue. The example file is refused for inference until every
# REPLACE_ field is replaced with values discovered from live endpoints.
MODEL_CATALOG=/etc/llm-router/catalog.json
MODEL_CATALOG_FILE=./catalog.json

# Batch-only deployment catalogue (optional; absent disables batch spill). Its
# own file, never merged into the synchronous chat catalogue; only the batch
# scheduler reads it. Compose binds BATCH_CATALOG_FILE below read-only at
# this in-gateway path; `setup.mjs --native` rewrites BATCH_CATALOG to the
# host path.
BATCH_CATALOG=/etc/llm-router/batch-catalog.json
BATCH_CATALOG_FILE=./catalog.batch.example.json

# Optional batch content-holding override. Unset = dirname(SQLITE_PATH)/
# batch-content: /var/lib/llm-router/batch-content on Compose (inside the
# sqlite-data volume, so it persists with control.sqlite) and
# ./data/batch-content native. Held results never live in control.sqlite.
# BATCH_RESULTS_DIR=

# Credentials named by catalogue entries (`credentialEnvVar`). Fill only in `.env`.
# GUFO_API_KEY is Gufo's --api-key-file value; OPENROUTER_API_KEY serves the
# cloud tier and batch spill. A cloud Jev System One deployment names its own
# variable (for example TYPESAFE_API_KEY).
GUFO_API_KEY=
# OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=

# Optional System One (Kev on Gufo, or cloud Jev). Copy the example to a
# private file and set AUXILIARY_CATALOG_FILE if endpoints or rates change.
# AUXILIARY_CATALOG=/etc/llm-router/auxiliary.json
# AUXILIARY_CATALOG_FILE=catalog.auxiliary.json

# Published gateway bind. Default loopback. For private LAN, set both
# GATEWAY_BIND to that interface IP and APP_ORIGIN to the matching origin.
# Never 0.0.0.0 on a public network.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=3000
# Dedicated Prometheus listener (unset disables metrics). Must differ from gateway PORT.
# METRICS_PORT=9091

# Compose profiles: `webui` adds Open WebUI. Gufo runs on the GPU host, not in Compose.
COMPOSE_PROFILES=

# Optional Open WebUI. Use a dedicated GATEWAY API key created in the console;
# never put the OpenRouter key here. Setup generates the stable WebUI secret.
WEBUI_GATEWAY_KEY=
WEBUI_SECRET_KEY=
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3001
WEBUI_ORIGIN=http://127.0.0.1:3001
