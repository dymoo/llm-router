# Laya classifier, CPU image. NPU/VitisAI is a host SDK flow (docs/npu.md),
# not baked in and not an untested default.

FROM python:3.12-slim-bookworm
WORKDIR /opt/laya
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV LAYA_HOST=0.0.0.0
ENV LAYA_PORT=8090
ENV LAYA_BACKEND=cpu
ENV LAYA_CACHE_DIR=/var/cache/laya
ENV LAYA_ONNX_PATH=/var/cache/laya/onnx/laya.onnx
ENV LAYA_EP_CONTEXT_DIR=/var/cache/laya/ep-context

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /var/cache/laya/onnx /var/cache/laya/ep-context \
  && useradd --system --uid 1001 --create-home laya \
  && chown -R laya:laya /var/cache/laya /opt/laya

COPY services/laya /opt/laya
RUN if [ -f requirements.txt ]; then \
      pip install --no-cache-dir -r requirements.txt; \
    elif [ -f pyproject.toml ]; then \
      pip install --no-cache-dir .; \
    else \
      echo "services/laya is missing requirements.txt or pyproject.toml" >&2; \
      exit 1; \
    fi \
  && chown -R laya:laya /opt/laya

USER laya
EXPOSE 8090
CMD ["python", "-m", "laya_service"]
